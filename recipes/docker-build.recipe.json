{
  "id": "docker-build",
  "name": "Docker Build",
  "description": "Build a container image from a bounded relative context directory and explicit image tag.",
  "version": "1.0.0",
  "author": {
    "name": "Guardrail Team",
    "email": "team@guardrail.dev"
  },
  "inputs": {
    "image": {
      "type": "string",
      "description": "Container image reference including tag",
      "pattern": "^[a-z0-9.-]+(?:/[a-z0-9._-]+)+:[A-Za-z0-9._-]{1,80}$"
    },
    "context_dir": {
      "type": "string",
      "description": "Relative Docker build context directory",
      "approval_mode": "path_policy",
      "rules": {
        "must_be_relative": true,
        "deny_segments": [".."],
        "max_depth": 8
      }
    }
  },
  "steps": [
    {
      "id": "build",
      "description": "Build the Docker image",
      "run": {
        "command": "docker",
        "args": ["build", "--tag", "{{inputs.image}}", "{{inputs.context_dir}}"],
        "mode": "structured"
      }
    }
  ],
  "guardrails": {
    "constraints": [
      "Only a bounded relative build context is allowed",
      "The image tag is explicit and approval-bound",
      "No arbitrary docker flags such as --privileged or custom network modes are allowed"
    ],
    "invariants": [
      "The recipe only performs docker build",
      "The build context cannot escape the approved workspace scope",
      "Structured argv prevents hidden shell expansion"
    ]
  },
  "approval_required": true,
  "risk_level": "medium",
  "category": "packages",
  "tags": ["docker", "container", "build"],
  "channel": "verified",
  "signature": null
}
