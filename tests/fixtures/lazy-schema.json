{
  "version": 1,
  "kind": "workflow_definition",
  "name": "stress-lazy-schema",
  "projectRoot": ".",
  "entryStep": "simple_echo",
  "maxIterations": 1,
  "services": [],
  "steps": [
    {
      "id": "simple_echo",
      "type": "task",
      "run": {
        "command": "echo",
        "args": ["hello"],
        "cwd": ".",
        "mode": "structured",
        "envPolicy": { "inherit": true }
      },
      "validator": "exit_code",
      "on": { "success": "done", "validation_failed": "abort" }
    }
  ]
}
